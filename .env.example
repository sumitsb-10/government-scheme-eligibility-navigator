
# Copy this file to .env and fill in your keys

# Choose one LLM provider (Gemini is free-tier friendly)
GOOGLE_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Which provider to use: "gemini" or "groq"
LLM_PROVIDER=gemini

# Gemini model — use gemini-3.5-flash-lite (fast, free tier, higher quota)
# Alternative: gemini-3.5-flash (more capable but lower daily quota)
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq model (free tier)
GROQ_MODEL=llama-3.1-8b-instant

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./data/chroma_db

# Scheme documents directory
SCHEME_DOCS_DIR=./data/scheme_docs

# FastAPI backend URL (used by Streamlit)
BACKEND_URL=http://localhost:8000
